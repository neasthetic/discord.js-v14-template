{
    "name": "bot",
    "version": "1.0.0",
    "description": "Discord application made by Yuri",
    "module": "build/server.js",
    "author": {
        "name": "Yuri Maturana",
        "url": "https://github.com/yurimaturana"
    },
    "license": "MIT",
    "type": "module",
    "scripts": {
        "check": "tsc --noEmit",
        "dev": "tsx --env-file .env ./src/server.ts",
        "dev:dev": "tsx --env-file .env.dev ./src/server.ts",
        "watch": "tsx --watch --env-file .env ./src/server.ts",
        "watch:dev": "tsx --watch --env-file .env.dev ./src/server.ts",
        "start": "node --env-file .env ./build/server.js",
        "start:dev": "node --env-file .env.dev ./build/server.js",
        "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
        "build": "rimraf ./build && tsc",
        "format": "eslint . && prettier --write .",
        "lint": "eslint ."
    },
    "imports": {
        "#*": "./build/*.js",
        "#emojis": "./build/config/emojis.json",
        "#settings": "./build/config/settings.json"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^20.19.43",
        "eslint": "^9.39.4",
        "prettier": "^3.8.4",
        "rimraf": "^6.1.3",
        "tsx": "^4.22.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.61.1"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "discord.js": "^14.26.4",
        "mongoose": "^9.7.1",
        "zod": "^3.25.76"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
